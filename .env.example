# N.I.A — Neural Intelligence Assistant
# Environment Variable Reference
#
# Copy this file to .env and fill in your values.
# Only ANTHROPIC_API_KEY (or any one provider key) is required to start.

# ═══════════════════════════════════════════════════════════════════════
# Core Configuration
# ═══════════════════════════════════════════════════════════════════════

# NIA home directory (default: ~/.nia/)
# NIA_HOME=/home/user/.nia

# Active profile (default: "default")
# NIA_PROFILE=work

# ═══════════════════════════════════════════════════════════════════════
# API Keys — at least one is required
# ═══════════════════════════════════════════════════════════════════════

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/
# OPENAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/
# DEEPSEEK_API_KEY=

# Groq — https://console.groq.com/
# GROQ_API_KEY=

# OpenRouter (multi-provider) — https://openrouter.ai/
# OPENROUTER_API_KEY=

# Together AI — https://api.together.xyz/
# TOGETHER_API_KEY=

# Fireworks AI — https://fireworks.ai/
# FIREWORKS_API_KEY=

# Cerebras — https://cerebras.ai/
# CEREBRAS_API_KEY=

# NVIDIA NIM — https://integrate.api.nvidia.com/
# NVIDIA_API_KEY=

# Google Gemini — https://aistudio.google.com/
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# xAI (Grok) — https://x.ai/
# XAI_API_KEY=

# Perplexity — https://www.perplexity.ai/
# PERPLEXITY_API_KEY=

# Mistral AI — https://console.mistral.ai/
# MISTRAL_API_KEY=

# DeepInfra — https://deepinfra.com/
# DEEPINFRA_API_KEY=

# Hugging Face — https://huggingface.co/
# HF_API_KEY=

# Azure OpenAI — https://azure.microsoft.com/products/ai-services/openai-service
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ═══════════════════════════════════════════════════════════════════════
# Model & Provider Overrides
# ═══════════════════════════════════════════════════════════════════════

# Override the default model
# NIAHARNESS_MODEL=claude-sonnet-4-20250514

# Override the API format ("anthropic" or "openai")
# NIAHARNESS_API_FORMAT=anthropic

# Override the base URL
# NIAHARNESS_BASE_URL=
# ANTHROPIC_BASE_URL=

# Override max output tokens
# NIAHARNESS_MAX_TOKENS=16384

# ═══════════════════════════════════════════════════════════════════════
# Budget Enforcement
# ═══════════════════════════════════════════════════════════════════════

# Max tool-calling iterations per turn (default: 90)
# NIAHARNESS_MAX_TURNS=90

# Max estimated cost in USD per session (default: unlimited)
# NIAHARNESS_MAX_BUDGET_USD=10.00

# Max total tokens for continuation logic (default: unlimited)
# NIAHARNESS_TOKEN_BUDGET=1000000

# ═══════════════════════════════════════════════════════════════════════
# Auxiliary Model (for background tasks: compaction, review, title-gen)
# ═══════════════════════════════════════════════════════════════════════

# Use a cheaper model for background tasks (recommended: Claude Haiku)
# NIA_AUX_MODEL=claude-3-haiku-20240307
# NIA_AUX_API_KEY=
# NIA_AUX_PROVIDER=anthropic
# NIA_AUX_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════
# Background Review (proactive memory/skill review)
# ═══════════════════════════════════════════════════════════════════════

# Disable background review (default: enabled)
# NIA_BACKGROUND_REVIEW=0

# Review interval in seconds (default: 30)
# NIA_BACKGROUND_REVIEW_INTERVAL=30

# Override review model/provider
# NIA_BACKGROUND_REVIEW_MODEL=
# NIA_BACKGROUND_REVIEW_PROVIDER=

# ═══════════════════════════════════════════════════════════════════════
# Delegate Task (sub-agent delegation)
# ═══════════════════════════════════════════════════════════════════════

# Auto-approve sub-agent commands (default: 0 = auto-deny)
# NIA_DELEGATE_AUTO_APPROVE=1

# Max delegation depth (default: 2)
# NIA_DELEGATE_MAX_DEPTH=2

# Max concurrent children (default: 3)
# NIA_DELEGATE_MAX_CONCURRENT=3

# Sub-agent timeout in seconds (default: 120)
# NIA_DELEGATE_TIMEOUT=120

# Max sub-agent turns (default: 10)
# NIA_DELEGATE_MAX_TURNS=10

# Max summary chars (default: 24000)
# NIA_DELEGATE_MAX_SUMMARY_CHARS=24000

# ═══════════════════════════════════════════════════════════════════════
# Vision Analysis
# ═══════════════════════════════════════════════════════════════════════

# NIA_VISION_MODEL=
# NIA_VISION_API_KEY=
# NIA_VISION_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════
# Image Generation
# ═══════════════════════════════════════════════════════════════════════

# NIA_IMAGE_MODEL=dall-e-3
# NIA_IMAGE_API_KEY=
# NIA_IMAGE_BASE_URL=
# NIA_IMAGE_OUTPUT_DIR=
# NIA_IMAGE_MAX_RETRIES=3

# ═══════════════════════════════════════════════════════════════════════
# Computer Use
# ═══════════════════════════════════════════════════════════════════════

# CUA driver command
# NIA_CUA_DRIVER_CMD=

# ═══════════════════════════════════════════════════════════════════════
# MCP (Model Context Protocol)
# ═══════════════════════════════════════════════════════════════════════

# Allow MCP connections to private/localhost URLs (default: blocked)
# NIA_MCP_ALLOW_PRIVATE_URLS=1

# ═══════════════════════════════════════════════════════════════════════
# Gateway (Telegram)
# ═══════════════════════════════════════════════════════════════════════

# Telegram bot token — https://t.me/BotFather
# NIA_TELEGRAM_BOT_TOKEN=

# ═══════════════════════════════════════════════════════════════════════
# Data & Logging Directories
# ═══════════════════════════════════════════════════════════════════════

# NIAHARNESS_DATA_DIR=~/.niaharness/data
# NIAHARNESS_LOGS_DIR=~/.niaharness/logs

# ═══════════════════════════════════════════════════════════════════════
# Web Search
# ═══════════════════════════════════════════════════════════════════════

# Tavily search API — https://tavily.com/
# TAVILY_API_KEY=

# Brave search API — https://brave.com/search/api/
# BRAVE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════
# AWS Bedrock (if using Bedrock provider)
# ═══════════════════════════════════════════════════════════════════════

# AWS_REGION=us-east-1
# BEDROCK_MODEL=

# ═══════════════════════════════════════════════════════════════════════
# Google Vertex AI (if using Vertex provider)
# ═══════════════════════════════════════════════════════════════════════

# GCLOUD_PROJECT=
# GCLOUD_REGION=
# VERTEX_MODEL=

# ═══════════════════════════════════════════════════════════════════════
# Frontend (React TUI)
# ═══════════════════════════════════════════════════════════════════════

# NIAHARNESS_FRONTEND_CONFIG= (JSON, set by react_launcher.py)
# NIAHARNESS_FRONTEND_CONFIG_FILE= (temp file path fallback)
# NIAHARNESS_FRONTEND_RAW_RETURN= (for e2e testing)
# NIAHARNESS_FRONTEND_SCRIPT= (JSON array of scripted inputs for e2e)

# ═══════════════════════════════════════════════════════════════════════
# Misc
# ═══════════════════════════════════════════════════════════════════════

# SUDO_PASSWORD= (for sudo -S transformation; leave unset to block sudo -S)
# SUDO_PASSWORD=

# Editor for /soul edit command
# EDITOR=nano
# VISUAL=code
