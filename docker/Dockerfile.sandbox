# =============================================================================
# Dockerfile.sandbox — N.I.A. Base Sandbox (Layer 1)
# =============================================================================
# Minimal, hardened base OS layer. Provides:
#   - Debian slim base
#   - Isolated sandbox user (uid 1000 — non-root)
#   - Core shell utilities
#   - Clean /workspace mount point
#
# Built as: nia-sandbox:latest
#   docker build -t nia-sandbox:latest -f docker/Dockerfile.sandbox .
#
# All other sandbox images (sandbox-common, sandbox-browser) build on this.
# =============================================================================

FROM debian:bookworm-slim

LABEL maintainer="N.I.A. Team"
LABEL description="N.I.A. Sandbox Base — hardened OS layer"
LABEL version="1.0"

ENV DEBIAN_FRONTEND=noninteractive

# ── Core OS + shell utilities ─────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    wget \
    git \
    jq \
    nano \
    procps \
    unzip \
    zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Isolated non-root sandbox user (uid 1000) ─────────────────────────────────
RUN useradd --create-home --shell /bin/bash --uid 1000 sandbox

# ── Shared workspace (world-writable so host volume mounts work) ──────────────
RUN mkdir -p /workspace && chmod 777 /workspace

USER sandbox
WORKDIR /home/sandbox

# Keep alive for potential long-running tasks
CMD ["bash"]
