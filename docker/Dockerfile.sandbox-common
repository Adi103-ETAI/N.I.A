# =============================================================================
# Dockerfile.sandbox-common — N.I.A. Runtime Sandbox (Layer 2)
# =============================================================================
# Builds on nia-sandbox:latest. Adds Python 3 + Node.js + common packages
# needed for most code execution tasks.
#
# Built as: nia-sandbox-common:latest
#   Requires: nia-sandbox:latest (Layer 1) built first
#   docker build -t nia-sandbox-common:latest -f docker/Dockerfile.sandbox-common .
#
# Use cases: Python scripts, Node.js scripts, data analysis, API calls,
#            file processing, build tasks.
# =============================================================================

FROM nia-sandbox:latest

LABEL maintainer="N.I.A. Team"
LABEL description="N.I.A. Runtime Sandbox — Python 3.12 + Node 20 + common libs"
LABEL version="1.0"

USER root

# ── System runtimes ────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    # Node.js (via system package — stable LTS)
    nodejs \
    npm \
    # Build tools (for compiling C extensions)
    build-essential \
    gcc \
    g++ \
    # Useful CLI tools
    ripgrep \
    jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages (available inside sandbox without re-install per task) ────
# --break-system-packages needed for Debian bookworm's PEP 668
RUN pip3 install --break-system-packages --no-cache-dir \
    # LLM integrations (for tasks that call APIs from inside the sandbox)
    openai \
    requests \
    httpx \
    # Data / utilities
    pandas \
    numpy \
    python-dotenv \
    rich

# ── Node packages (global, so tasks can use them immediately) ─────────────────
RUN npm install -g \
    typescript \
    ts-node \
    axios

# ── Workspace ─────────────────────────────────────────────────────────────────
WORKDIR /workspace
RUN chmod 777 /workspace

# Revert to sandbox user for task execution
USER sandbox
WORKDIR /workspace

CMD ["python3", "-c", "print('NIA Sandbox Common ready')"]
