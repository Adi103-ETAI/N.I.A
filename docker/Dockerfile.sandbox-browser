# =============================================================================
# Dockerfile.sandbox-browser — N.I.A. Browser Automation Sandbox
# =============================================================================
# Layer 3: Playwright + Chromium browser automation environment.
# Builds on nia-sandbox-common to add browser capabilities.
#
# Built as: nia-sandbox-browser:latest
# Requires: nia-sandbox-common:latest built first (via docker-setup.sh)
#
# Use cases:
#   - Web scraping / crawling tasks
#   - Screenshot capture
#   - Form automation / e2e browser testing
#   - JavaScript-heavy site interaction
# =============================================================================

FROM nia-sandbox-common:latest

LABEL maintainer="N.I.A. Team"
LABEL description="N.I.A. Browser Sandbox — Playwright + Chromium"
LABEL version="1.0"

USER root

# ── Browser dependencies (Chromium requires many system libs) ─────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        # Chromium system deps
        libnss3 \
        libatk-bridge2.0-0 \
        libdrm2 \
        libxkbcommon0 \
        libgtk-3-0 \
        libgbm1 \
        libasound2 \
        libxss1 \
        libxtst6 \
        fonts-liberation \
        fonts-noto \
        xvfb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Playwright + browser install ──────────────────────────────────────────────
RUN pip install --no-cache-dir playwright && \
    playwright install chromium --with-deps

# ── Sandbox workspace ─────────────────────────────────────────────────────────
WORKDIR /workspace
RUN mkdir -p /workspace && chmod 777 /workspace

# ── Entrypoint: support both direct Python execution and Node.js ──────────────
CMD ["python3", "-c", "print('NIA Browser Sandbox ready')"]
