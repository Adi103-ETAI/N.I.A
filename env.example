# =============================================================================
# N.I.A. Configuration - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# AI Provider API Keys (at least one required)
# =============================================================================

# NVIDIA NIM API Key (primary provider, required)
NVIDIA_API_KEY=nvapi-your-key-here

# Groq API Key (for fast inference)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=

# HuggingFace API Key (optional)
HUGGINGFACE_API_KEY=

# =============================================================================
# NVIDIA NIM Endpoint Configuration
# =============================================================================

# NVIDIA NIM API endpoint URL (default: NVIDIA cloud)
# Change this to point to a self-hosted NIM instance if needed
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# =============================================================================
# LLM Model Selection
# =============================================================================

# Primary LLM model (used for NIA brain)
LLM_MODEL=meta/llama-3.1-70b-instruct

# High-quality LLM for complex reasoning (SupervisorAgent)
LLM_MODEL_SMART=meta/llama-3.1-70b-instruct

# Fast LLM for simple tasks (TaraAgent fallback)
LLM_MODEL_FAST=meta/llama-3.1-70b-instruct

# Vision-capable LLM for IRIS
LLM_MODEL_VISION=meta/llama-3.2-90b-vision-instruct

# LLM temperature (0.0-2.0)
LLM_TEMPERATURE=0.7

# =============================================================================
# Voice Settings
# =============================================================================

# Wake words for voice activation (comma-separated)
WAKE_WORDS=nia,jarvis,hey nia

# Edge TTS voice name
TTS_VOICE=en-US-AriaNeural

# Enable voice mode by default
VOICE_ENABLED=true

# Seconds before returning to sleep after wake word
WAKE_WORD_TIMEOUT=30.0

# =============================================================================
# System Settings
# =============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Days to retain conversation history
MEMORY_RETENTION_DAYS=7

# Force local embeddings (set to false to use OpenAI embeddings)
FORCE_LOCAL_EMBEDDINGS=false

# =============================================================================
# Optional: Local/External Providers
# =============================================================================

# Local Ollama host URL
OLLAMA_HOST=http://localhost:11434
